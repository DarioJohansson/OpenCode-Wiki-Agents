{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "coordinator",
  "agent": {
    "coordinator": {
      "description": "Orchestrates the wiki workflow, interprets natural language, and delegates to specialized subagents with high token efficiency",
      "mode": "primary",
      "prompt": "{file:.opencode/prompts/coordinator.md}",
      "permission": {
        "read": "allow",
        "question": "allow",
        "task": {
          "init-worker": "allow",
          "contextualizer": "allow",
          "scribe": "allow",
          "publisher": "allow",
          "git-worker": "allow",
          "researcher": "allow"
        }
      }
    },
    "init-worker": {
      "description": "Verifies wiki repo and drafts directory exist, proposes fixes via git-worker if needed",
      "mode": "subagent",
      "prompt": "{file:.opencode/prompts/init-worker.md}",
      "permission": {
        "bash": "allow",
        "read": "allow",
        "task": {
          "git-worker": "allow"
        }
      }
    },
    "contextualizer": {
      "description": "Analyzes raw files in drafts/, asks user for interpretation, builds information cache",
      "mode": "subagent",
      "prompt": "{file:.opencode/prompts/contextualizer.md}",
      "permission": {
        "read": "allow",
        "write": "allow",
        "edit": "allow"
      }
    },
    "scribe": {
      "description": "Creates formatted wiki page drafts from cache + user guidance",
      "mode": "subagent",
      "prompt": "{file:.opencode/prompts/scribe.md}",
      "permission": {
        "read": "allow",
        "write": "allow",
        "edit": "allow"
      }
    },
    "publisher": {
      "description": "Copies finalized drafts from drafts/ to wiki/ on user confirmation",
      "mode": "subagent",
      "prompt": "{file:.opencode/prompts/publisher.md}",
      "permission": {
        "read": "allow",
        "write": "allow",
        "edit": "allow",
        "bash": "allow"
      }
    },
    "git-worker": {
      "description": "Commits and pushes wiki repo changes on user confirmation",
      "mode": "subagent",
      "prompt": "{file:.opencode/prompts/git-worker.md}",
      "permission": {
        "bash": "allow",
        "read": "allow"
      }
    },
    "researcher": {
      "description": "Searches the web and wiki at user-specified paths, saves raw data to drafts/",
      "mode": "subagent",
      "prompt": "{file:.opencode/prompts/researcher.md}",
      "permission": {
        "websearch": "allow",
        "webfetch": "allow",
        "write": "allow",
        "edit": "allow",
        "read": "allow"
      }
    }
  }
}
